<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>CMA Master Learner Guide — ICMAI 2022 Quiz &amp; Study Hub</title>
  <script src="https://cdn.tailwindcss.com/3.4.17"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&family=Space+Grotesk:wght@600;700&display=swap" rel="stylesheet" />
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'system-ui', 'sans-serif'],
            display: ['Space Grotesk', 'Inter', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace']
          }
        }
      }
    };
  </script>
  <style>
    body {
      background-color: #070b14;
      color: #e2e8f0;
      font-family: 'Inter', system-ui, sans-serif;
    }
    .glass-card {
      background: rgba(15, 23, 42, 0.85);
      border: 1px solid rgba(148, 163, 184, 0.14);
      backdrop-filter: blur(12px);
    }
    .nav-pill-active {
      background: linear-gradient(135deg, #10b981 0%, #059669 100%);
      color: #022c22;
      font-weight: 700;
    }
    .custom-scroll::-webkit-scrollbar { width: 6px; height: 6px; }
    .custom-scroll::-webkit-scrollbar-track { background: #0f172a; }
    .custom-scroll::-webkit-scrollbar-thumb { background: #334155; border-radius: 999px; }
    @media print {
      body { background: #ffffff !important; color: #000000 !important; }
      .no-print { display: none !important; }
    }
  </style>
</head>
<body class="min-h-screen flex flex-col antialiased selection:bg-emerald-500/30 selection:text-emerald-200">

  <!-- Toast Container -->
  <div id="toast-container" class="fixed top-4 right-4 z-50 flex flex-col gap-2 max-w-sm w-full pointer-events-none px-4 sm:px-0"></div>

  <!-- Top Navigation -->
  <header class="sticky top-0 z-40 border-b border-slate-800/80 bg-[#070b14]/95 backdrop-blur-md no-print">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-3 flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-emerald-400 to-indigo-600 flex items-center justify-center shadow-lg shadow-emerald-500/20 font-display font-bold text-slate-950 text-lg">
          CMA
        </div>
        <div>
          <h1 class="font-display font-bold text-base sm:text-lg tracking-tight text-white leading-tight">
            CMA MASTER LEARNER GUIDE
          </h1>
          <p class="text-[11px] text-emerald-400 font-medium tracking-wide uppercase">
            ICMAI Syllabus 2022 • Inter &amp; Final
          </p>
        </div>
      </div>

      <!-- Primary Nav -->
      <nav id="main-nav" class="flex flex-wrap items-center gap-1.5 text-xs sm:text-sm">
        <button data-view="dashboard" class="nav-btn px-3 py-1.5 rounded-lg text-slate-300 hover:bg-slate-800 transition">Dashboard</button>
        <button data-view="subjects" class="nav-btn px-3 py-1.5 rounded-lg text-slate-300 hover:bg-slate-800 transition">Subjects &amp; Quiz</button>
        <button data-view="resources" class="nav-btn px-3 py-1.5 rounded-lg text-slate-300 hover:bg-slate-800 transition">Resources</button>
        <button data-view="chat" class="nav-btn px-3 py-1.5 rounded-lg text-slate-300 hover:bg-slate-800 transition">Support Chat</button>
        <button data-view="leaderboard" class="nav-btn px-3 py-1.5 rounded-lg text-slate-300 hover:bg-slate-800 transition">Leaderboard</button>
        <button data-view="admin" class="nav-btn px-3 py-1.5 rounded-lg text-amber-300 hover:bg-amber-500/10 border border-amber-500/30 transition">Admin</button>
      </nav>

      <!-- Active User Badge -->
      <div id="user-badge" class="hidden items-center gap-2.5 bg-slate-900/90 border border-slate-700/70 rounded-xl px-3 py-1.5">
        <div class="text-right">
          <div id="badge-name" class="text-xs font-semibold text-white leading-tight"></div>
          <div id="badge-meta" class="text-[10px] font-mono text-emerald-400"></div>
        </div>
        <button id="logout-btn" class="text-xs px-2.5 py-1 rounded-lg bg-rose-500/15 text-rose-300 hover:bg-rose-500/25 border border-rose-500/30 transition">
          Logout
        </button>
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 py-6">

    <!-- VIEW 1: DASHBOARD / AUTH -->
    <section id="view-dashboard" class="space-y-6">
      <!-- Hero Banner -->
      <div class="glass-card rounded-2xl p-6 sm:p-8 relative overflow-hidden">
        <div class="absolute -right-16 -top-16 w-64 h-64 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -left-16 -bottom-16 w-64 h-64 bg-indigo-500/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="relative flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
          <div class="space-y-2 max-w-2xl">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-500/15 text-emerald-300 border border-emerald-500/30">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              Cloud-Synced Quiz &amp; Mock Exam Portal
            </span>
            <h2 class="font-display text-2xl sm:text-3xl font-bold text-white tracking-tight">
              Master ICMAI Intermediate &amp; Final Exams
            </h2>
            <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
              30-question timed MCQ sprints (90s/question, +2 / -0.333 negative marking), 10 ICMAI-pattern Mock Exams per paper, curated Google Drive study materials, public doubt-clearance chat, and live leaderboard.
            </p>
          </div>
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 shrink-0">
            <div class="bg-slate-900/90 border border-slate-800 rounded-xl p-3 text-center">
              <div class="font-display text-xl font-bold text-emerald-400">18</div>
              <div class="text-[11px] text-slate-400">CMA Papers</div>
            </div>
            <div class="bg-slate-900/90 border border-slate-800 rounded-xl p-3 text-center">
              <div class="font-display text-xl font-bold text-indigo-400">90s</div>
              <div class="text-[11px] text-slate-400">Per Question</div>
            </div>
            <div class="bg-slate-900/90 border border-slate-800 rounded-xl p-3 text-center col-span-2 sm:col-span-1">
              <div class="font-display text-xl font-bold text-amber-400">10x</div>
              <div class="text-[11px] text-slate-400">Mock Exams</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Auth Panels (shown when logged out) -->
      <div id="auth-panels" class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Registration Form -->
        <div class="glass-card rounded-2xl p-6 space-y-4">
          <div class="flex items-center justify-between">
            <div>
              <h3 class="font-display text-lg font-bold text-white">New Student Registration</h3>
              <p class="text-xs text-slate-400">Generates your Unique ID &amp; backs up profile to Cloud Storage</p>
            </div>
            <span class="text-xs font-mono px-2.5 py-1 rounded-md bg-emerald-500/10 text-emerald-300 border border-emerald-500/20">FREE</span>
          </div>
          <form id="register-form" class="space-y-3.5">
            <div>
              <label class="block text-xs font-medium text-slate-300 mb-1">Full Name *</label>
              <input id="reg-name" type="text" required placeholder="e.g., Anujith B Krishna" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-sm text-white focus:outline-none focus:border-emerald-500" />
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label class="block text-xs font-medium text-slate-300 mb-1">Gender *</label>
                <select id="reg-gender" required class="w-full px-3.5 py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-sm text-white focus:outline-none focus:border-emerald-500">
                  <option value="">Select Gender</option>
                  <option value="Male">Male</option>
                  <option value="Female">Female</option>
                  <option value="Other">Other</option>
                </select>
              </div>
              <div>
                <label class="block text-xs font-medium text-slate-300 mb-1">Date of Birth *</label>
                <input id="reg-dob" type="date" required class="w-full px-3.5 py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-sm text-white focus:outline-none focus:border-emerald-500" />
              </div>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label class="block text-xs font-medium text-slate-300 mb-1">CMA Level *</label>
                <select id="reg-level" required class="w-full px-3.5 py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-sm text-white focus:outline-none focus:border-emerald-500">
                  <option value="">Select Level</option>
                  <option value="CMA Intermediate">CMA Intermediate</option>
                  <option value="CMA Final">CMA Final</option>
                </select>
              </div>
              <div>
                <label class="block text-xs font-medium text-slate-300 mb-1">Email (Optional)</label>
                <input id="reg-email" type="email" placeholder="student@example.com" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-sm text-white focus:outline-none focus:border-emerald-500" />
              </div>
            </div>
            <button type="submit" class="w-full py-3 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-400 hover:to-teal-400 text-slate-950 font-bold text-sm transition shadow-lg shadow-emerald-500/20">
              Register &amp; Generate Unique ID
            </button>
          </form>
        </div>

        <!-- Login Form -->
        <div class="glass-card rounded-2xl p-6 flex flex-col justify-between space-y-5">
          <div class="space-y-4">
            <div>
              <h3 class="font-display text-lg font-bold text-white">Student Login</h3>
              <p class="text-xs text-slate-400">Enter your Unique ID &amp; DOB to restore your progress from Cloud Backup</p>
            </div>
            <form id="login-form" class="space-y-3.5">
              <div>
                <label class="block text-xs font-medium text-slate-300 mb-1">Unique Student ID *</label>
                <input id="login-id" type="text" required placeholder="e.g., CMA-INT-2026-1001" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-sm font-mono text-white uppercase focus:outline-none focus:border-indigo-500" />
              </div>
              <div>
                <label class="block text-xs font-medium text-slate-300 mb-1">Date of Birth *</label>
                <input id="login-dob" type="date" required class="w-full px-3.5 py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-sm text-white focus:outline-none focus:border-indigo-500" />
              </div>
              <button type="submit" class="w-full py-3 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-sm transition shadow-lg shadow-indigo-500/20">
                Login &amp; Restore Data
              </button>
            </form>
          </div>

          <!-- Quick Demo Account -->
          <div class="bg-slate-900/80 border border-slate-800 rounded-xl p-4 space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-xs font-semibold text-slate-300">Instant Demo Student Access</span>
              <span class="text-[10px] font-mono text-emerald-400">PRE-SEEDED</span>
            </div>
            <p class="text-xs text-slate-400">
              Try immediately with ID <code class="text-emerald-300 font-mono">CMA-INT-2026-1001</code> &amp; DOB <code class="text-emerald-300 font-mono">2002-10-18</code>, or register your own ID.
            </p>
            <button id="demo-login-btn" type="button" class="w-full py-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs font-semibold text-emerald-300 border border-slate-700 transition">
              One-Click Demo Login
            </button>
          </div>
        </div>
      </div>

      <!-- Logged-in Student Overview -->
      <div id="student-overview" class="hidden space-y-6">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <div class="glass-card rounded-2xl p-5">
            <div class="text-xs text-slate-400">Unique ID</div>
            <div id="ov-id" class="font-mono text-lg font-bold text-emerald-400 mt-1"></div>
            <div id="ov-level" class="text-xs text-slate-300 mt-1"></div>
          </div>
          <div class="glass-card rounded-2xl p-5">
            <div class="text-xs text-slate-400">Total Leaderboard Points</div>
            <div id="ov-points" class="font-display text-2xl font-bold text-white mt-1">0</div>
            <div class="text-xs text-indigo-400 mt-1">Updates after every quiz</div>
          </div>
          <div class="glass-card rounded-2xl p-5">
            <div class="text-xs text-slate-400">Quizzes Attempted</div>
            <div id="ov-attempts" class="font-display text-2xl font-bold text-white mt-1">0</div>
            <div class="text-xs text-slate-400 mt-1">30 MCQs per round</div>
          </div>
          <div class="glass-card rounded-2xl p-5">
            <div class="text-xs text-slate-400">Development (Avg %)</div>
            <div id="ov-dev" class="font-display text-2xl font-bold text-amber-400 mt-1">0%</div>
            <div class="text-xs text-slate-400 mt-1">Cumulative score average</div>
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          <div class="glass-card rounded-2xl p-5 lg:col-span-2 space-y-3">
            <div class="flex items-center justify-between">
              <h3 class="font-display font-bold text-white">Knowledge Development Trend</h3>
              <button id="go-subjects-btn" class="text-xs px-3 py-1.5 rounded-lg bg-emerald-500 text-slate-950 font-bold hover:bg-emerald-400 transition">
                Start New Quiz →
              </button>
            </div>
            <div class="relative h-64">
              <canvas id="dev-chart"></canvas>
            </div>
          </div>
          <div class="glass-card rounded-2xl p-5 space-y-3">
            <h3 class="font-display font-bold text-white">Quick Actions</h3>
            <div class="space-y-2.5">
              <button data-jump="subjects" class="quick-jump w-full text-left px-4 py-3 rounded-xl bg-slate-900 hover:bg-slate-800 border border-slate-800 transition flex items-center justify-between">
                <span class="text-sm font-medium text-white">Select Paper &amp; Start Quiz</span>
                <span class="text-emerald-400">→</span>
              </button>
              <button data-jump="resources" class="quick-jump w-full text-left px-4 py-3 rounded-xl bg-slate-900 hover:bg-slate-800 border border-slate-800 transition flex items-center justify-between">
                <span class="text-sm font-medium text-white">Study Material &amp; 10 Mock Exams</span>
                <span class="text-indigo-400">→</span>
              </button>
              <button data-jump="chat" class="quick-jump w-full text-left px-4 py-3 rounded-xl bg-slate-900 hover:bg-slate-800 border border-slate-800 transition flex items-center justify-between">
                <span class="text-sm font-medium text-white">Public Doubt Clearance Chat</span>
                <span class="text-amber-400">→</span>
              </button>
              <button data-jump="leaderboard" class="quick-jump w-full text-left px-4 py-3 rounded-xl bg-slate-900 hover:bg-slate-800 border border-slate-800 transition flex items-center justify-between">
                <span class="text-sm font-medium text-white">View Live Leaderboard</span>
                <span class="text-rose-400">→</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- VIEW 2: SUBJECT SELECTION & QUIZ ENGINE -->
    <section id="view-subjects" class="hidden space-y-6">
      <!-- Subject Picker -->
      <div id="subject-picker" class="space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div>
            <h2 class="font-display text-2xl font-bold text-white">Subject Selection</h2>
            <p class="text-xs sm:text-sm text-slate-400">
              Questions shuffle &amp; refresh on every attempt with minimal repeats. 30 MCQs • 1m 30s/question • +2 / -1 per 3 wrong.
            </p>
          </div>
          <div class="flex items-center gap-2 bg-slate-900 border border-slate-800 p-1 rounded-xl">
            <button id="lvl-inter-btn" class="px-3.5 py-1.5 rounded-lg text-xs font-bold transition">CMA Intermediate (8 Papers)</button>
            <button id="lvl-final-btn" class="px-3.5 py-1.5 rounded-lg text-xs font-bold transition">CMA Final (10 Papers)</button>
          </div>
        </div>
        <div id="subjects-grid" class="space-y-6"></div>
      </div>

      <!-- Active Quiz Arena -->
      <div id="quiz-arena" class="hidden space-y-5">
        <!-- Quiz Top Bar -->
        <div class="glass-card rounded-2xl p-4 flex flex-wrap items-center justify-between gap-4">
          <div>
            <div id="quiz-paper-title" class="font-display font-bold text-white text-base sm:text-lg"></div>
            <div class="text-xs text-slate-400">
              Question <span id="quiz-q-num" class="text-emerald-400 font-bold">1</span> of <span id="quiz-q-total">30</span>
              • +2 Correct / -0.33 Wrong
            </div>
          </div>
          <div class="flex items-center gap-3">
            <div class="px-4 py-2 rounded-xl bg-slate-900 border border-slate-700 flex items-center gap-2">
              <span class="text-xs text-slate-400">Time Left:</span>
              <span id="quiz-timer" class="font-mono text-lg font-bold text-emerald-400">01:30</span>
            </div>
            <button id="quit-quiz-btn" class="px-3 py-2 rounded-xl bg-rose-500/15 hover:bg-rose-500/25 text-rose-300 text-xs font-semibold border border-rose-500/30 transition">
              End Quiz
            </button>
          </div>
        </div>

        <!-- Timer Progress Bar -->
        <div class="w-full h-2 bg-slate-900 rounded-full overflow-hidden border border-slate-800">
          <div id="quiz-timer-bar" class="h-full bg-gradient-to-r from-emerald-400 to-indigo-500 transition-all duration-1000" style="width: 100%"></div>
        </div>

        <!-- Question Card -->
        <div class="glass-card rounded-2xl p-6 sm:p-8 space-y-6">
          <div id="quiz-question-text" class="text-base sm:text-lg font-semibold text-white leading-relaxed"></div>
          <div id="quiz-options" class="grid grid-cols-1 gap-3"></div>
          <div class="flex items-center justify-between pt-2 border-t border-slate-800/80">
            <span id="quiz-feedback" class="text-xs font-medium text-slate-400">Select an option before timer expires (auto-skips at 00:00).</span>
            <button id="next-q-btn" class="px-5 py-2.5 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-sm transition disabled:opacity-40" disabled>
              Next Question →
            </button>
          </div>
        </div>
      </div>

      <!-- Quiz Report Card -->
      <div id="quiz-report" class="hidden glass-card rounded-2xl p-6 sm:p-8 space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-800 pb-4">
          <div>
            <span class="text-xs font-mono uppercase tracking-wider text-emerald-400">Quiz Completed</span>
            <h2 id="rep-paper" class="font-display text-2xl font-bold text-white mt-1"></h2>
          </div>
          <button id="rep-back-btn" class="px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-bold transition">
            Back to Subjects
          </button>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
          <div class="bg-slate-900/90 border border-slate-800 rounded-xl p-4">
            <div class="text-xs text-slate-400">Total Score (Max)</div>
            <div id="rep-max" class="font-display text-2xl font-bold text-white mt-1">60</div>
          </div>
          <div class="bg-slate-900/90 border border-slate-800 rounded-xl p-4">
            <div class="text-xs text-slate-400">Total Mark Obtained</div>
            <div id="rep-obtained" class="font-display text-2xl font-bold text-emerald-400 mt-1">0</div>
          </div>
          <div class="bg-slate-900/90 border border-slate-800 rounded-xl p-4">
            <div class="text-xs text-slate-400">Negative Mark</div>
            <div id="rep-negative" class="font-display text-2xl font-bold text-rose-400 mt-1">0</div>
          </div>
          <div class="bg-slate-900/90 border border-slate-800 rounded-xl p-4">
            <div class="text-xs text-slate-400">Accuracy</div>
            <div id="rep-accuracy" class="font-display text-2xl font-bold text-indigo-400 mt-1">0%</div>
          </div>
          <div class="bg-slate-900/90 border border-amber-500/30 rounded-xl p-4 col-span-2 sm:col-span-1">
            <div class="text-xs text-amber-300">Development (Avg %)</div>
            <div id="rep-dev" class="font-display text-2xl font-bold text-amber-400 mt-1">0%</div>
          </div>
        </div>

        <div id="rep-breakdown" class="text-xs text-slate-300 bg-slate-900/70 border border-slate-800 rounded-xl p-4"></div>
      </div>
    </section>

    <!-- VIEW 3: RESOURCES & 10 MOCK EXAMINATIONS -->
    <section id="view-resources" class="hidden space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h2 class="font-display text-2xl font-bold text-white">CMA Resources Hub</h2>
          <p class="text-xs sm:text-sm text-slate-400">Direct access &amp; download from your Google Drive CMA Repository + 10 ICMAI-Pattern Mock Exams.</p>
        </div>
        <a href="https://drive.google.com/drive/folders/1niN90VStBdWMXlC0lymSBT91ah0i3Rh6" target="_blank" rel="noopener noreferrer" class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-xs font-semibold text-emerald-300 transition shrink-0">
          Open Master Google Drive Folder ↗
        </a>
      </div>

      <!-- 4 Resource Tabs -->
      <div class="flex flex-wrap gap-2 border-b border-slate-800 pb-3">
        <button data-rtab="study" class="rtab-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition">1. Study Material</button>

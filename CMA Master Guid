  function shuffleArray(arr) {
    const a = [...arr];
    for (let i = a.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
  }

  function startQuiz(paperId) {
    const user = getCurrentUser();
    if (!user) {
      showToast('Please register or login first to track your score and leaderboard rank.', 'warn');
      switchView('dashboard');
      return;
    }

    const allPapers = [...PAPERS['CMA Intermediate'], ...PAPERS['CMA Final']];
    const paper = allPapers.find(p => p.id === paperId);
    if (!paper) return;

    const bank = state.mcqs[paper.mcqPaper] || [];
    if (!bank.length) {
      showToast('No MCQs available for this paper yet. Add some in Admin!', 'error');
      return;
    }

    // Prioritize unseen questions first to minimize repeats
    const seenSet = new Set(user.seenMcqs || []);
    const unseen = shuffleArray(bank.filter(item => !seenSet.has(item.q)));
    const seen = shuffleArray(bank.filter(item => seenSet.has(item.q)));
    let pool = [...unseen, ...seen];

    // Build up to 30 questions (repeating shuffled if bank < 30, or taking 30 unique if >= 30)
    const targetCount = 30;
    const selected = [];
    while (selected.length < targetCount) {
      for (const q of pool) {
        if (selected.length >= targetCount) break;
        selected.push(q);
      }
      pool = shuffleArray(pool);
    }

    // Track seen questions
    user.seenMcqs = Array.from(new Set([...(user.seenMcqs || []), ...selected.slice(0, bank.length).map(x => x.q)])).slice(-250);
    saveState();

    quiz = {
      paper,
      questions: selected,
      idx: 0,
      correct: 0,
      wrong: 0,
      skipped: 0,
      timerSec: 90,
      timerHandle: null,
      answered: false
    };

    document.getElementById('subject-picker').classList.add('hidden');
    document.getElementById('quiz-report').classList.add('hidden');
    document.getElementById('quiz-arena').classList.remove('hidden');
    document.getElementById('quiz-paper-title').textContent = `${paper.code}: ${paper.name}`;
    document.getElementById('quiz-q-total').textContent = String(quiz.questions.length);

    renderQuizQuestion();
  }

  function renderQuizQuestion() {
    clearInterval(quiz.timerHandle);
    quiz.answered = false;
    quiz.timerSec = 90;

    const qObj = quiz.questions[quiz.idx];
    document.getElementById('quiz-q-num').textContent = String(quiz.idx + 1);
    document.getElementById('quiz-question-text').textContent = `${quiz.idx + 1}. ${qObj.q}`;
    document.getElementById('quiz-feedback').textContent = 'Select an option before timer expires (auto-skips at 00:00).';
    document.getElementById('next-q-btn').disabled = true;

    const optsEl = document.getElementById('quiz-options');
    const labels = ['A', 'B', 'C', 'D'];
    optsEl.innerHTML = qObj.opts.map((opt, i) => `
      <button data-opt-idx="${i}" class="quiz-opt-btn w-full text-left px-4 py-3.5 rounded-xl bg-slate-900 hover:bg-slate-800 border border-slate-700/80 text-sm text-slate-200 transition flex items-start gap-3">
        <span class="font-mono font-bold text-xs px-2 py-0.5 rounded bg-slate-800 text-indigo-300 shrink-0">${labels[i]}</span>
        <span>${opt}</span>
      </button>
    `).join('');

    optsEl.querySelectorAll('.quiz-opt-btn').forEach(btn => {
      btn.addEventListener('click', () => handleOptionSelect(Number(btn.dataset.optIdx)));
    });

    updateTimerDisplay();
    quiz.timerHandle = setInterval(() => {
      quiz.timerSec -= 1;
      updateTimerDisplay();
      if (quiz.timerSec <= 0) {
        clearInterval(quiz.timerHandle);
        quiz.skipped += 1;
        showToast('Time up! Question skipped automatically.', 'warn');
        advanceQuiz();
      }
    }, 1000);
  }

  function updateTimerDisplay() {
    const m = Math.floor(quiz.timerSec / 60);
    const s = quiz.timerSec % 60;
    const timerEl = document.getElementById('quiz-timer');
    timerEl.textContent = `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
    timerEl.className = quiz.timerSec <= 15
      ? 'font-mono text-lg font-bold text-rose-400 animate-pulse'
      : 'font-mono text-lg font-bold text-emerald-400';

    const pct = Math.max(0, (quiz.timerSec / 90) * 100);
    document.getElementById('quiz-timer-bar').style.width = `${pct}%`;
  }

  function handleOptionSelect(chosenIdx) {
    if (quiz.answered) return;
    quiz.answered = true;
    clearInterval(quiz.timerHandle);

    const qObj = quiz.questions[quiz.idx];
    const isCorrect = chosenIdx === qObj.ans;
    if (isCorrect) quiz.correct += 1;
    else quiz.wrong += 1;

    document.querySelectorAll('.quiz-opt-btn').forEach(btn => {
      const idx = Number(btn.dataset.optIdx);
      btn.disabled = true;
      if (idx === qObj.ans) {
        btn.className = 'quiz-opt-btn w-full text-left px-4 py-3.5 rounded-xl bg-emerald-500/20 border border-emerald-500 text-sm text-emerald-200 flex items-start gap-3';
      } else if (idx === chosenIdx && !isCorrect) {
        btn.className = 'quiz-opt-btn w-full text-left px-4 py-3.5 rounded-xl bg-rose-500/20 border border-rose-500 text-sm text-rose-200 flex items-start gap-3';
      } else {
        btn.className = 'quiz-opt-btn w-full text-left px-4 py-3.5 rounded-xl bg-slate-900/50 border border-slate-800 text-sm text-slate-500 flex items-start gap-3';
      }
    });

    document.getElementById('quiz-feedback').textContent = isCorrect
      ? 'Correct! +2.00 points earned.'
      : `Incorrect! 3 wrong answers deduct 1 point (-0.33).`;
    document.getElementById('next-q-btn').disabled = false;
  }

  function advanceQuiz() {
    if (quiz.idx + 1 < quiz.questions.length) {
      quiz.idx += 1;
      renderQuizQuestion();
    } else {
      finishQuiz();
    }
  }

  function finishQuiz() {
    clearInterval(quiz.timerHandle);
    document.getElementById('quiz-arena').classList.add('hidden');
    document.getElementById('quiz-report').classList.remove('hidden');

    const totalQ = quiz.questions.length;
    const maxScore = totalQ * 2;
    const positive = quiz.correct * 2;
    const negative = Number((quiz.wrong / 3).toFixed(2));
    const obtained = Number(Math.max(0, positive - negative).toFixed(2));
    const attempted = quiz.correct + quiz.wrong;
    const accuracy = attempted > 0 ? Number(((quiz.correct / attempted) * 100).toFixed(1)) : 0;
    const pct = maxScore > 0 ? Number(((obtained / maxScore) * 100).toFixed(1)) : 0;

    const user = getCurrentUser();
    if (user) {
      user.points = Number((user.points + obtained).toFixed(2));
      user.attempts.push({
        paper: quiz.paper.code,
        score: obtained,
        max: maxScore,
        negative,
        accuracy,
        pct,
        date: new Date().toISOString().slice(0, 10)
      });
      saveState();
    }

    const devAvg = user ? calcDevelopmentAvg(user) : pct;
    document.getElementById('rep-paper').textContent = `${quiz.paper.code}: ${quiz.paper.name}`;
    document.getElementById('rep-max').textContent = String(maxScore);
    document.getElementById('rep-obtained').textContent = String(obtained);
    document.getElementById('rep-negative').textContent = `-${negative}`;
    document.getElementById('rep-accuracy').textContent = `${accuracy}%`;
    document.getElementById('rep-dev').textContent = `${devAvg}%`;
    document.getElementById('rep-breakdown').textContent =
      `Summary: ${quiz.correct} Correct (+${positive}), ${quiz.wrong} Wrong (-${negative}), ${quiz.skipped} Auto-Skipped (0). Leaderboard updated dynamically!`;

    showToast(`Quiz saved! +${obtained} points added to Leaderboard.`, 'success');
  }

